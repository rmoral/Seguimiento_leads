# ============================================
# Seguimiento Leads - Environment variables
# ============================================
# Copy this file to .env and fill in real values.

# --- Postgres ---
POSTGRES_USER=leads
POSTGRES_PASSWORD=changeme
POSTGRES_DB=seguimiento_leads
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+psycopg://leads:changeme@db:5432/seguimiento_leads
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Redis (used in Phase 3 for Celery) ---
REDIS_URL=redis://redis:6379/0

# --- Email providers ---
# Gmail OAuth (Phase 2). Get values from Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/email-accounts/gmail/callback
# Where to redirect the browser after OAuth completes (your frontend).
OAUTH_FRONTEND_REDIRECT=http://localhost:5173/settings

# Symmetric key used to encrypt OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- AI (filled in Phase 4) ---
ANTHROPIC_API_KEY=
